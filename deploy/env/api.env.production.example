# FilomOnline API — ÜRETİM ortam değişkenleri
# Sunucuda: APP_DIR/apps/api/.env olarak kopyala ve doldur. GİT'E GİRMEZ.

# --- Veritabanı (uzak MySQL) ---
DATABASE_URL="mysql://KULLANICI:SIFRE@HOST:3306/VERITABANI"

# --- Uygulama ---
PORT=3001
NODE_ENV=production
# Tek domain: web ile API aynı origin. Birden fazla ise virgülle ayır.
CORS_ORIGIN=https://app.ornek.com
# Müşteriye giden linklerin (teklif e-postası vb.) kökü — ÜRETİMDE ZORUNLU
WEB_URL=https://app.ornek.com

# --- JWT (GÜÇLÜ ve RASTGELE üret: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=DEGISTIR
JWT_REFRESH_SECRET=DEGISTIR
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- S3 / MinIO (nginx üzerinden HTTPS) ---
S3_ENDPOINT=https://s3.ornek.com
S3_REGION=us-east-1
S3_BUCKET=filomonline
S3_ACCESS_KEY=DEGISTIR
S3_SECRET_KEY=DEGISTIR

# --- Gemini (OCR) — kullanılıyorsa ---
GEMINI_API_KEY=
