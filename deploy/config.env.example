# FilomOnline deploy ayarları — kopyala: cp config.env.example config.env
# config.env GİT'E GİRMEZ (.gitignore). Değerleri kendi sunucuna göre doldur.

# --- Uygulama alan adı (web + API aynı domainde, API /api altında) ---
DOMAIN=app.ornek.com

# --- Depolama (MinIO) alt alan adı — HTTPS mixed-content sorununu çözer ---
# Bu ada bir DNS A kaydı aç, sunucunun IP'sine baksın. Boş bırakırsan S3 proxy kurulmaz.
S3_DOMAIN=s3.ornek.com
# nginx'in MinIO'ya baktığı adres (prod MinIO). Ayrı sunucuysa IP:port, aynı sunucuysa 127.0.0.1:9000
MINIO_UPSTREAM=22.6.102.180:9000

# --- SSH / sunucu ---
SSH_HOST=sunucu-ip-veya-adres
SSH_USER=root
SSH_PORT=22

# --- Sunucudaki yollar ---
APP_DIR=/var/www/filomonline          # kaynak kodun kopyalanacağı dizin
WEB_ROOT=/var/www/filomonline/apps/web/dist   # nginx'in sunduğu statik web
PM2_APP=filom-api                     # PM2 süreç adı

# Let's Encrypt bildirim e-postası
LETSENCRYPT_EMAIL=admin@ornek.com
