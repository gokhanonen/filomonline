# FilomOnline — uygulama (web + API) nginx site şablonu.
# Değişkenler setup-server.sh tarafından envsubst ile doldurulur: ${DOMAIN} ${WEB_ROOT}
# Önce HTTP olarak kurulur; `certbot --nginx` çalışınca 443/SSL ve HTTP->HTTPS yönlendirmesini EKLER.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # AI asistanı base64 foto gönderebilir; evrak/foto yüklemeleri doğrudan MinIO'ya gider.
    client_max_body_size 25m;

    # Statik web (React SPA)
    root ${WEB_ROOT};
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hash'li varlıklar uzun süre cache'lenir
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # API (NestJS global prefix: /api/v1) — yol korunur
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Socket.io (gerçek zamanlı bildirim/sohbet) — WebSocket upgrade
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # SPA fallback — her yolu index.html'e düşür
    location / {
        try_files $uri $uri/ /index.html;
    }
}
